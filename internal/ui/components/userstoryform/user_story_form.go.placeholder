// UserStoryForm represents the form for creating a user story with LLM processing
type UserStoryForm struct {
	story            models.UserStory
	model            *formModels.UserStoryFormModel
	inputs           []textinput.Model
	cursor           cursor.Model
	focused          int
	submitted        bool
	width            int
	height           int
	confirmChanges   bool
	spinner          spinner.Model
	fieldPrevValues  map[int]string
	processor        llm.LLMProcessor
	configManager    *llm.ConfigManager
	processingCtx    context.Context
	processingCancel context.CancelFunc
}

// New creates a new UserStoryForm
func New(us models.UserStory, processor llm.LLMProcessor, configManager *llm.ConfigManager) *UserStoryForm {
	form := &UserStoryForm{
		story:           us,
		cursor:          cursor.New(),
		focused:         0,
		processor:       processor,
		configManager:   configManager,
		spinner:         spinner.New(),
		fieldPrevValues: make(map[int]string),
	}

	// Initialize the model
	form.model = formModels.NewUserStoryFormModel(processor)

	// Initialize inputs
	form.inputs = make([]textinput.Model, 5)
	
	// Initialize title input
	form.inputs[0] = textinput.New()
	form.inputs[0].Placeholder = "User Story Title"
	form.inputs[0].Focus()
	form.inputs[0].Width = 60
	form.inputs[0].Prompt = ""
	
	// Initialize as-a input
	form.inputs[1] = textinput.New()
	form.inputs[1].Placeholder = "As a..."
	form.inputs[1].Width = 60
	form.inputs[1].Prompt = ""
	
	// Initialize i-want input
	form.inputs[2] = textinput.New()
	form.inputs[2].Placeholder = "I want..."
	form.inputs[2].Width = 60
	form.inputs[2].Prompt = ""
	
	// Initialize so-that input
	form.inputs[3] = textinput.New()
	form.inputs[3].Placeholder = "So that..."
	form.inputs[3].Width = 60
	form.inputs[3].Prompt = ""
	
	// Initialize acceptance criteria input
	form.inputs[4] = textinput.New()
	form.inputs[4].Placeholder = "Acceptance criteria (one per line)"
	form.inputs[4].Width = 60
	form.inputs[4].Prompt = ""
	form.inputs[4].CharLimit = 0
	form.inputs[4].SetValue(strings.Join(us.AcceptanceCriteria, "\n"))

	// Set values from user story
	if us.Title != "" {
		form.inputs[0].SetValue(us.Title)
	}
	
	if us.AsA != "" {
		form.inputs[1].SetValue(us.AsA)
	}
	
	if us.IWant != "" {
		form.inputs[2].SetValue(us.IWant)
	}
	
	if us.SoThat != "" {
		form.inputs[3].SetValue(us.SoThat)
	}
	
	// Store initial values for paste detection
	for i, input := range form.inputs {
		form.fieldPrevValues[i] = input.Value()
	}
	
	return form
}

// Init initializes the form
func (f *UserStoryForm) Init() tea.Cmd {
	return textinput.Blink
}

// Update handles messages and updates the form
func (f *UserStoryForm) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	
	// Handle spinner updates
	spinnerModel, spinnerCmd := f.spinner.Update(msg)
	f.spinner = spinnerModel.(spinner.Model)
	cmds = append(cmds, spinnerCmd)

	// Handle different message types
	switch msg := msg.(type) {
	case tea.KeyMsg:
		// TODO: MVI - Implement paste event detection using clipboard.IsPasteEvent
		
		// Handle key messages
		switch msg.String() {
		case "esc":
			// TODO: MVI - Call f.model.CancelProcessing() when ESC is pressed during LLM processing
			
			if f.model.GetProcessingState() == llm.ProcessingActive {
				// TODO: MVI - Set visual indication that processing was cancelled
				return f, nil
			}
			
			// If not processing, ESC is used to cancel the form
			return f, tea.Quit
			
		case "tab", "shift+tab", "up", "down":
			// Handle keyboard navigation between fields
			// TODO: MVI - Implement proper field navigation with highlighting of auto-populated fields
		
		case "enter":
			if f.focused == len(f.inputs)-1 {
				// Submit the form if the last input is focused
				f.submitted = true
				return f, tea.Quit
			}
			// Move to the next field
			f.focused = (f.focused + 1) % len(f.inputs)
			
		}
	}
	
	// Update the active input
	if f.focused >= 0 && f.focused < len(f.inputs) {
		// Get current focused input
		f.inputs[f.focused].Focus()
		
		// Check for paste events by comparing current value with previous value
		// TODO: MVI - Implement checkForPasteEvents to detect paste events
		
		// Update the input
		newInput, inputCmd := f.inputs[f.focused].Update(msg)
		f.inputs[f.focused] = newInput
		cmds = append(cmds, inputCmd)
		
		// Store the new value for paste detection
		f.fieldPrevValues[f.focused] = f.inputs[f.focused].Value()
	}
	
	return f, tea.Batch(cmds...)
}

// View renders the form
func (f *UserStoryForm) View() string {
	var b strings.Builder
	
	// TODO: MVI - Implement full UI rendering with visual feedback for auto-populated fields
	// TODO: MVI - Add visual indicators for fields with different confidence levels
	// TODO: MVI - Show API key configuration message when needed
	
	// Basic form header
	b.WriteString("Create a new user story\n\n")
	
	// Show spinner during processing
	if f.model.GetProcessingState() == llm.ProcessingActive {
		b.WriteString(f.spinner.View() + " Processing your text...\n\n")
		// TODO: MVI - Add timeout warning when processing takes too long
	}
	
	// Show processing error if there was one
	if f.model.GetProcessingState() == llm.ProcessingError {
		errorStyle := lipgloss.NewStyle().Foreground(lipgloss.Color("9"))
		b.WriteString(errorStyle.Render("✗ Error: " + f.model.GetLastError()) + "\n\n")
	}
	
	// Show API key not configured message if needed
	if f.model.GetProcessingState() == llm.ProcessingNotConfigured {
		infoStyle := lipgloss.NewStyle().Foreground(lipgloss.Color("12"))
		b.WriteString(infoStyle.Render("ℹ OpenAI API key not configured. Use 'usm settings openai set-key' to enable LLM processing.") + "\n\n")
	}
	
	// Render each input field
	for i, input := range f.inputs {
		// Field labels
		var fieldLabel string
		switch i {
		case 0:
			fieldLabel = "Title:"
		case 1:
			fieldLabel = "As a:"
		case 2:
			fieldLabel = "I want:"
		case 3:
			fieldLabel = "So that:"
		case 4:
			fieldLabel = "Acceptance criteria:"
		}
		
		// TODO: MVI - Add highlighting for auto-populated fields based on confidence scores
		
		b.WriteString(fieldLabel + "\n")
		b.WriteString(input.View() + "\n\n")
	}
	
	// Footer with instructions
	b.WriteString("\n(ESC to cancel, ENTER to move to next field)\n")
	
	return b.String()
}

// GetUserStory returns the user story with the values from the form
func (f *UserStoryForm) GetUserStory() models.UserStory {
	// TODO: MVI - Add validation for user story fields before returning
	
	us := f.story
	us.Title = f.inputs[0].Value()
	us.AsA = f.inputs[1].Value()
	us.IWant = f.inputs[2].Value()
	us.SoThat = f.inputs[3].Value()
	
	// Split acceptance criteria by newlines
	if f.inputs[4].Value() != "" {
		us.AcceptanceCriteria = strings.Split(f.inputs[4].Value(), "\n")
	} else {
		us.AcceptanceCriteria = []string{}
	}
	
	return us
}

